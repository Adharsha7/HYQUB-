# HYQUB PQ Verification Engine — environment configuration template
#
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# All variables use the prefix HYQUB_ (enforced by pydantic-settings).
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------

# Runtime environment. Controls which routes are registered.
# Must be "production" in any non-local deployment.
# Allowed values: production | development
# Default: production
HYQUB_ENVIRONMENT=production

# Explicit opt-in to development/diagnostic routes (/dev/sign,
# /dev/generate-keypair). Requires HYQUB_ENVIRONMENT=development
# AND chain_id == 31337. Application refuses to start if this is
# true on a non-local chain.
# Default: false
HYQUB_ENABLE_DEV_TOOLS=false

# Application name shown in /health and OpenAPI docs.
# Default: HYQUB PQ Verification Engine
# HYQUB_APP_NAME=HYQUB PQ Verification Engine

# Application version reported in /health.
# Default: 0.1.0
# HYQUB_VERSION=0.1.0

# ---------------------------------------------------------------
# CORS
# ---------------------------------------------------------------

# JSON list of allowed browser origins.
# allow_credentials=True is set, so ["*"] is NOT valid — list
# origins explicitly.
# Default: ["http://localhost:3000"]
HYQUB_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------
# VERIFIER CONFIGURATION
# ---------------------------------------------------------------

# Identity of this verifier instance. Used in quorum result logs
# and in approval token verifier_ids.
# Default: verifier-a
HYQUB_VERIFIER_ID=verifier-a

# Minimum number of verifier approvals required before an
# ApprovalToken is issued. Must be >= 1.
# Default: 2
HYQUB_REQUIRED_QUORUM=2

# ---------------------------------------------------------------
# BLOCKCHAIN RPC
# ---------------------------------------------------------------

# HTTP JSON-RPC endpoint for the connected chain.
# Default: http://127.0.0.1:8545  (local Anvil)
HYQUB_RPC_URL=http://127.0.0.1:8545

# ---------------------------------------------------------------
# SIGNING KEYS  —  NEVER commit real values
# ---------------------------------------------------------------

# Ethereum private key used to submit transactions to
# HYQUBRegistry (registerWallet, rotateKey) and to act as the
# ERC-4337 bundler for EntryPoint.handleOps.
# Must match the `registrar` address set when HYQUBRegistry was
# deployed (registrar = msg.sender in the constructor).
HYQUB_REGISTRAR_PRIVATE_KEY=0xYOUR_REGISTRAR_PRIVATE_KEY_HERE

# Ethereum private key used to ECDSA-sign approval token payload
# hashes (EIP-191 personal-sign). The corresponding address must
# match the `approvalSigner` argument passed to the HYQUBWallet
# constructor at deploy time.
# This key is intentionally separate from the registrar key.
HYQUB_APPROVAL_SIGNER_PRIVATE_KEY=0xYOUR_APPROVAL_SIGNER_PRIVATE_KEY_HERE

# ---------------------------------------------------------------
# CONTRACT ADDRESSES
# ---------------------------------------------------------------

# Address of the deployed ERC-4337 EntryPoint contract.
HYQUB_ENTRYPOINT_ADDRESS=0xYOUR_ENTRYPOINT_ADDRESS_HERE

# Address of the deployed HYQUBRegistry contract.
HYQUB_REGISTRY_ADDRESS=0xYOUR_REGISTRY_ADDRESS_HERE

# Address of the deployed HYQUBWallet contract that this backend
# instance manages.
HYQUB_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Address of the TestTarget contract used in integration tests.
# Not required in production; only used by test scripts.
HYQUB_TEST_TARGET_ADDRESS=0xYOUR_TEST_TARGET_ADDRESS_HERE
